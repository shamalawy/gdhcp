# Build output
/dist/
# Compiled binary built in-tree (Makefile writes dist/, but a stray
# `go build -o gdhcp` at the root should never be committed)
/gdhcp

# Local run logs
*.log

# Local configuration (never commit secrets/DSNs)
/config.yaml

# Kubernetes overlay secrets (docs/deploy/kubernetes.md instructs operators
# to create deploy/kubernetes/overlays/{production,staging}/.env.secret and
# .jwt.secret in-tree, documented as "gitignored" — this pattern is what
# makes that true; without it, real DB credentials/JWT signing keys created
# exactly as documented would be picked up by a routine `git add`).
**/*.secret

# Go
*.test
*.out
/vendor/

# Frontend
/web/node_modules/
/web/dist/**
!/web/dist/index.html
/web/.angular/
/web/e2e/reports/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
