# Keep the Docker build context small and avoid leaking local secrets/state
# into images. When building from the repo root with `docker build -f
# deploy/docker/Dockerfile .`, Docker reads .dockerignore from the build
# context root (this file), not from deploy/docker/.

.git
.github

# Local, uncommitted deployment config/secrets
deploy/docker/config.yaml
deploy/kubernetes/**/*.secret.yaml
**/*.env
!deploy/systemd/gdhcp.env

# Build output / caches — rebuilt inside the image
dist/
web/dist/
web/node_modules/
web/.angular/
coverage.out

# Editor/OS cruft
.vscode
.idea
*.swp
.DS_Store

# Docs aren't needed inside the image
docs/
*.md

# AI assistant tooling and local development state
.code-review-graph/
.claude/
.mcp.json
.cursor/
.cursorrules
CLAUDE.md
AGENTS.md
